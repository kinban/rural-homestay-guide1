---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rural Homestay Guide">
  <!-- 🏔️ Hero Banner Container -->
  <div class="hero-card">
    <div class="hero-overlay">
      <span class="badge">Offline Accessible</span>
      <h1>Rural Homestay Playbook</h1>
      <p>A practical guide for hosts, local guides, and conscious travelers in remote villages.</p>
      <a href="#modules" class="cta-button">Explore Modules ↓</a>
    </div>
  </div>

  <!-- Rest of your homepage content / module grid goes here -->
</Layout>

<style>
  .hero-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    /* Hero Background Image with Fallback Color */
    background: #1b382b url('/hero-banner.jpg') center/cover no-repeat;
    min-height: 240px;
    display: flex;
    align-items: flex-end;
  }

  /* Dark Overlay for Text Legibility */
  .hero-overlay {
    background: linear-gradient(180deg, rgba(15,30,22,0.2) 0%, rgba(15,30,22,0.85) 100%);
    padding: 24px;
    width: 100%;
    color: #ffffff;
  }

  .badge {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255,255,255,0.3);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  h1 {
    font-size: 1.8rem;
    margin: 8px 0 4px 0;
    line-height: 1.2;
  }

  p {
    font-size: 0.95rem;
    margin-bottom: 16px;
    opacity: 0.9;
  }

  .cta-button {
    display: inline-block;
    background: #2e7d32;
    color: white;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
