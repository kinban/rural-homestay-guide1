---
interface Props {
  title: string;
}

const { title } = Astro.props;

// ⚠️ Replace 919876543210 with your actual WhatsApp phone number (country code + number, no spaces or +)
const phoneNumber = "919886630878"; 
const defaultMessage = encodeURIComponent(`Hi! I am reading "${title}" on the Rural Homestay Guide and have some feedback:`);
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${defaultMessage}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        max-width: 650px;
        margin: 0 auto;
        padding: 20px;
        padding-bottom: 90px; /* Extra space so floating button doesn't block text */
        line-height: 1.6;
        color: #222;
        background-color: #fafafa;
      }

      a { 
        color: #0b6623; 
      }

      h1, h2, h3 { 
        color: #0b6623; 
      }

      /* In-Page Feedback Card */
      .feedback-card {
        margin-top: 50px;
        padding: 20px;
        background-color: #f2f7f3;
        border: 1px solid #c8e6c9;
        border-radius: 10px;
        text-align: center;
      }

      .feedback-card h3 {
        margin-top: 0;
        margin-bottom: 8px;
        font-size: 1.1rem;
      }

      .feedback-card p {
        font-size: 0.9rem;
        color: #555;
        margin-bottom: 15px;
      }

      .feedback-btn {
        display: inline-block;
        background-color: #25d366;
        color: #ffffff !important;
        padding: 10px 18px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
        font-size: 0.9rem;
        box-shadow: 0px 2px 5px rgba(0,0,0,0.1);
        transition: background-color 0.2s ease;
      }

      .feedback-btn:hover {
        background-color: #128c7e;
      }

      /* Floating WhatsApp Button */
      .whatsapp-float {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background-color: #25d366;
        color: #ffffff !important;
        padding: 12px 18px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: bold;
        font-size: 0.9rem;
        box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.2);
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: transform 0.2s ease, background-color 0.2s ease;
      }

      .whatsapp-float:hover {
        background-color: #128c7e;
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body>
    <!-- Main Page Content -->
    <slot />

    <!-- In-Page Bottom Feedback Card -->
    <div class="feedback-card">
      <h3>💡 Have feedback or suggestions for this page?</h3>
      <p>No logins or signups needed. Send host/traveler suggestions directly via WhatsApp.</p>
      <a 
        href={whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="feedback-btn"
      >
        💬 Share Feedback on WhatsApp
      </a>
    </div>

    <!-- Persistent Floating WhatsApp Button -->
    <a 
      href={whatsappUrl} 
      class="whatsapp-float" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="Send feedback on WhatsApp"
    >
      💬 WhatsApp
    </a>
  </body>
</html>
