---
interface Props {
	title?: string;
}

const { title = "Rural Homestay Guide" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="A practical offline guide for rural homestay hosts, local guides, and conscious travelers." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--accent-green: #2e7d32;
		--text-main: #1a2421;
	}

	html {
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}

	body {
		max-width: 680px;
		margin: 0 auto;
		padding: 20px;
		padding-bottom: 90px;
		line-height: 1.6;
		color: var(--text-main);

		/* 🌿 Lightweight SVG Background Pattern */
		background-color: #f8faf8;
		background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%232e7d32' fill-opacity='0.05' fill-rule='evenodd'%3E%3Ccircle cx='3' cy='3' r='1'/%3E%3C/g%3E%3C/svg%3E");
	}

	/* Base Styling for Markdown Elements */
	h1, h2, h3, h4 {
		color: #123015;
		line-height: 1.3;
	}

	a {
		color: var(--accent-green);
	}

	code {
		background: #eaefea;
		padding: 2px 6px;
		border-radius: 4px;
		font-size: 0.9em;
	}

	pre {
		padding: 16px;
		border-radius: 8px;
		overflow-x: auto;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		margin: 1rem 0;
	}

	th, td {
		border: 1px solid #d0dad1;
		padding: 8px 12px;
		text-align: left;
	}

	th {
		background-color: #e8f0e8;
	}
</style>
